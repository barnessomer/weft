{
  "id": "X.commit-gate",
  "level": 3,
  "required": false,
  "spec": "\u00a73.1 commit_gate",
  "title": "optional: a shell `git commit` is denied while an error is open (tool interception)",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/cart.ts",
        "old_text": "  return `${items.length} items`;",
        "new_text": "  return `${items.length} items, total ${calcTotal(items)}`;"
      },
      "expect_pre": {
        "decision": "deny"
      }
    },
    {
      "tool": {
        "kind": "shell",
        "command": "git commit -am wip"
      },
      "expect_pre": {
        "decision": "deny"
      },
      "apply": false
    }
  ]
}

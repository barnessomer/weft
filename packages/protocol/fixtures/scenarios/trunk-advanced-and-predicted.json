    },
    {
      "op": "system",
      "draft": {
        "kind": "land",
        "base_seq": 4,
        "change": "I-a",
        "payload": {
          "sha": "0badc0de",
          "op_id": "op_1"
        }
      },
      "expect": {
        "seq": 5,
        "status": "accepted",
        "writes": [
          {
            "key": "src/auth/session.ts#refreshToken",
            "kind": "body"

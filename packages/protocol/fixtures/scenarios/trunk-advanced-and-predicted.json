      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 5,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"

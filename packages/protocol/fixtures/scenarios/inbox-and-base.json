{
  "name": "inbox-and-base",
  "description": "§5.2: base_seq may not exceed what was delivered; inbox items are redelivered until acked; a rejecting check is logged, an accepting check is not.",
  "covers": [
    "5.2",
    "5.4",
    "8.3",
    "11"
  ],
  "repo": "demo",
  "start": "2026-10-05T14:00:00.000Z",
  "steps": [
    {
      "op": "hello",
      "as": "A",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "claude-a",
          "harness": "claude-code"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-1"
        },
        "change": "I-a"
      },
      "expect": {
        "type": "welcome",
        "session": "s1",
        "head_seq": 1,
        "delivered_through": 1
      }
    },
    {
      "op": "hello",
      "as": "B",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "codex-b",
          "harness": "codex"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-2"
        },
        "change": "I-b"
      },
      "expect": {
        "type": "welcome",
        "session": "s2",
        "head_seq": 2,
        "delivered_through": 2
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 99,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "type": "error",
        "error": {
          "code": "base_ahead",
          "retryable": false,
          "details": {
            "delivered_through": 2
          }
        }
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 2,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "seq": 3
      }
    },
    {
      "op": "submit",
      "as": "A",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 1,
          "writes": [
            {
              "key": "src/auth/session.ts#refreshToken",
              "kind": "signature"
            }
          ]
        }
      },
      "expect": {
        "seq": 4
      }
    },
    {
      "op": "drain",
      "as": "B",
      "expect": {
        "items": [
          {
            "id": 1,
            "seq": 4
          }
        ],
        "delivered_through": 4
      }
    },
    {
      "op": "drain",
      "as": "B",
      "expect": {
        "items": [
          {
            "id": 1,
            "seq": 4
          }
        ]
      }
    },
    {
      "op": "drain",
      "as": "B",
      "ack": 1,
      "expect": {
        "items": []
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "check",
        "event": {
          "kind": "edit",
          "base_seq": 4,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": null
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "check",
        "event": {
          "kind": "edit",
          "base_seq": 3,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "verdict": "reject",
        "seq": 5
      }
    },
    {
      "op": "events",
      "after": 4,
      "expect": {
        "events": [
          {
            "seq": 5,
            "status": "rejected",
            "mode": "check"
          }
        ]
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "land",
          "base_seq": 5,
          "payload": {
            "sha": "abcdef12",
            "op_id": "op_9"
          }
        }
      },
      "expect": {
        "type": "error",
        "error": {
          "code": "forbidden"
        }
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 5
        }
      },
      "expect": {
        "type": "error",
        "error": {
          "code": "invalid_message"
        }
      }
    }
  ]
}

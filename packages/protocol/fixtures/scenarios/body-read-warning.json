{
  "name": "body-read-warning",
  "description": "R2: a body-only change to a symbol the submitter reads yields a warning, never a rejection, and no contract_changed broadcast.",
  "covers": [
    "6.2 R2",
    "6.3"
  ],
  "repo": "demo",
  "start": "2026-10-05T14:00:00.000Z",
  "steps": [
    {
      "op": "hello",
      "as": "A",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "claude-a",
          "harness": "claude-code"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-1"
        },
        "change": "I-a"
      },
      "expect": {
        "type": "welcome",
        "session": "s1",
        "head_seq": 1,
        "delivered_through": 1
      }
    },
    {
      "op": "hello",
      "as": "B",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "codex-b",
          "harness": "codex"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-2"
        },
        "change": "I-b"
      },
      "expect": {
        "type": "welcome",
        "session": "s2",
        "head_seq": 2,
        "delivered_through": 2
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 2,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 3
      }
    },
    {
      "op": "submit",
      "as": "A",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 1,
          "writes": [
            {
              "key": "src/auth/session.ts#refreshToken",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 4
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 3,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 5,
        "inbox": [],
        "diagnostics": [
          {
            "severity": "warning",
            "code": "stale_read",
            "symbol": "src/auth/session.ts#refreshToken",
            "caused_by_seq": 4,
            "caused_by_agent": "claude-a"
          }
        ]
      }
    },
    {
      "op": "gate",
      "as": "B",
      "gate": "stop",
      "expect": {
        "allow": true
      }
    }
  ]
}
